{
  "manifest_version": 3,
  "name": "IMC Audio Router",
  "version": "1.0.0",
  "description": "Send a page's sound to a chosen audio device (for example a Voicemeeter input that is kept out of your stream recording).",
  "permissions": ["storage"],
  "content_scripts": [
    { "matches": ["https://*/*"], "js": ["glyph.js", "content.js"], "run_at": "document_idle" }
  ],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "browser_specific_settings": {
    "gecko": {
      "id": "imc-audio-router@itmecasey",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
